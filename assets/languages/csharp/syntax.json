{
  "schemaVersion": 1,
  "packageVersion": "0.3.0",
  "rules": [
    {
      "pattern": "//.*$",
      "scope": "comment"
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "scope": "comment"
    },
    {
      "begin": "\\$*(\"{3,})",
      "endCapture": 1,
      "scope": "string"
    },
    {
      "begin": "\\$@\"|@\\$\"",
      "end": "\"",
      "scope": "string",
      "escape": "\"\"|\\{\\{|\\}\\}",
      "contentRules": [
        {
          "begin": "\\{",
          "end": "\\}",
          "scope": "interpolation",
          "nested": true,
          "contentRules": [
            {
              "pattern": "\"(?:\\\\.|[^\"\\\\])*\"",
              "scope": "string"
            },
            {
              "pattern": "\\b\\d+\\b",
              "scope": "number"
            },
            {
              "pattern": "\\b(?:true|false|null)\\b",
              "scope": "constant"
            }
          ]
        }
      ]
    },
    {
      "begin": "@\"",
      "end": "\"",
      "scope": "string",
      "escape": "\"\""
    },
    {
      "begin": "\\$\"",
      "end": "\"",
      "scope": "string",
      "escape": "\\\\.|\\{\\{|\\}\\}",
      "singleLine": true,
      "contentRules": [
        {
          "begin": "\\{",
          "end": "\\}",
          "scope": "interpolation",
          "nested": true,
          "contentRules": [
            {
              "pattern": "\"(?:\\\\.|[^\"\\\\])*\"",
              "scope": "string"
            },
            {
              "pattern": "\\b\\d+\\b",
              "scope": "number"
            },
            {
              "pattern": "\\b(?:true|false|null)\\b",
              "scope": "constant"
            }
          ]
        }
      ]
    },
    {
      "pattern": "\"(?:\\\\.|[^\"\\\\])*\"|\\x27(?:\\\\.|[^\\x27\\\\])*\\x27",
      "scope": "string"
    },
    {
      "pattern": "^\\s*#\\s*(?:if|elif|else|endif|define|undef|region|endregion|error|warning|line|pragma|nullable)\\b.*",
      "scope": "directive"
    },
    {
      "pattern": "@[A-Za-z_]\\w*",
      "scope": "foreground"
    },
    {
      "pattern": "\\[(?:assembly\\s*:\\s*|module\\s*:\\s*)?[A-Za-z_]\\w*(?:\\.\\w+)*(?=\\s*[\\](,])",
      "scope": "annotation"
    },
    {
      "pattern": "\\b(?:true|false|null)\\b",
      "scope": "constant"
    },
    {
      "pattern": "\\b(?:bool|byte|char|decimal|double|float|int|long|nint|nuint|object|sbyte|short|string|uint|ulong|ushort|void)\\b",
      "scope": "type"
    },
    {
      "pattern": "\\b(?:abstract|add|alias|and|ascending|by|descending|equals|field|file|from|get|global|group|init|into|join|let|managed|nameof|nint|not|notnull|nuint|on|or|orderby|partial|remove|required|scoped|select|set|unmanaged|value|when|where|with|yield|as|async|await|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|goto|if|implicit|in|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|private|protected|public|readonly|record|ref|return|sbyte|sealed|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|var|virtual|void|volatile|while)\\b",
      "scope": "keyword"
    },
    {
      "pattern": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?)(?:[uU][lL]?|[lL][uU]?|[fFdDmM])?\\b|(?<!\\w)\\.\\d+(?:[eE][+-]?\\d+)?[fFdDmM]?",
      "scope": "number"
    },
    {
      "pattern": "(?<=\\.)[A-Za-z_][\\w]*(?![\\w]|\\s*[(<])",
      "scope": "property"
    },
    {
      "pattern": "\\b[A-Za-z_$][\\w$]*(?=\\s*(?:<[^()]+>)?\\s*\\()",
      "scope": "function"
    },
    {
      "pattern": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "scope": "type"
    },
    {
      "pattern": "\\?\\?=?|\\?\\.|=>|===?|!==?|\\*\\*=?|&&=?|\\|\\|=?|\\+\\+|--|<<=?|>>>=?|>>=?|[+*/%~^!<>=&|?:-]=?",
      "scope": "operator"
    },
    {
      "pattern": "[A-Za-z_$][\\w$]*",
      "scope": "foreground"
    }
  ]
}
