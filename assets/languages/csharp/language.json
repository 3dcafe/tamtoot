{
  "schemaVersion": 1,
  "packageVersion": "0.2.0",
  "id": "csharp",
  "name": "C#",
  "extensions": [
    ".cs"
  ],
  "comments": {
    "line": "//",
    "block": {
      "open": "/*",
      "close": "*/"
    }
  },
  "brackets": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "indentation": {
    "increaseAfter": "{"
  },
  "icons": {
    "symbol": "code"
  },
  "adapters": [],
  "fileTemplates": {
    "class": {
      "name": "Class",
      "extension": ".cs",
      "body": "public class {{name}}\n{\n}\n"
    },
    "interface": {
      "name": "Interface",
      "extension": ".cs",
      "body": "public interface {{name}}\n{\n}\n"
    }
  }
}
