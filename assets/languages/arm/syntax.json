{
  "schemaVersion": 1,
  "packageVersion": "0.1.0",
  "rules": [
    {
      "pattern": "@.*$",
      "scope": "comment"
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "scope": "comment"
    },
    {
      "begin": "\"",
      "end": "\"",
      "escape": "\\\\.",
      "singleLine": true,
      "scope": "string"
    },
    {
      "begin": "'",
      "end": "'",
      "escape": "\\\\.",
      "singleLine": true,
      "scope": "string"
    },
    {
      "pattern": "^\\s*(?:[A-Za-z_.$?][\\w.$?]*|\\d+):",
      "scope": "function"
    },
    {
      "pattern": "^\\s*[A-Za-z_.$?][\\w.$?]*(?=\\s+(?:[pP][rR][oO][cC]|[eE][nN][dD][pP]|[lL][aA][bB][eE][lL]|[eE][qQ][uU])\\b)",
      "scope": "function"
    },
    {
      "pattern": "(?:^\\s*\\.[A-Za-z_]\\w*|\\b(?:[sS][eE][cC][tT][iI][oO][nN]|[sS][eE][gG][mM][eE][nN][tT]|[eE][nN][dD][sS]|[gG][lL][oO][bB][aA][lL]|[eE][xX][tT][eE][rR][nN]|[pP][uU][bB][lL][iI][cC]|[bB][iI][tT][sS]|[dD][eE][fF][aA][uU][lL][tT]|[oO][rR][gG]|[eE][qQ][uU]|[dD][bB]|[dD][wW]|[dD][dD]|[dD][qQ]|[dD][tT]|[dD][oO]|[dD][yY]|[dD][zZ]|[rR][eE][sS][bB]|[rR][eE][sS][wW]|[rR][eE][sS][dD]|[rR][eE][sS][qQ]|[aA][lL][iI][gG][nN]|[tT][iI][mM][eE][sS]|[sS][tT][rR][uU][cC]|[eE][nN][dD][sS][tT][rR][uU][cC]|[pP][rR][oO][cC]|[eE][nN][dD][pP]|[eE][nN][dD]|[mM][aA][cC][rR][oO]|[eE][nN][dD][mM]|[bB][yY][tT][eE]|[wW][oO][rR][dD]|[dD][wW][oO][rR][dD]|[qQ][wW][oO][rR][dD]|[pP][tT][rR]|[oO][fF][fF][sS][eE][tT]|[nN][eE][aA][rR]|[fF][aA][rR])\\b)",
      "scope": "directive"
    },
    {
      "pattern": "(?:^|(?<=:)|(?<=;))\\s*(?:(?:[lL][oO][cC][kK]|[rR][eE][pP]|[rR][eE][pP][eE]|[rR][eE][pP][zZ]|[rR][eE][pP][nN][eE]|[rR][eE][pP][nN][zZ])\\s+)*[A-Za-z][\\w.]*",
      "scope": "keyword"
    },
    {
      "pattern": "\\b(?:[mM][sS][pP]|[pP][sS][pP]|[pP][rR][iI][mM][aA][sS][kK]|[bB][aA][sS][eE][pP][rR][iI]|[fF][aA][uU][lL][tT][mM][aA][sS][kK]|[cC][oO][nN][tT][rR][oO][lL])\\b",
      "scope": "type"
    },
    {
      "pattern": "(?<![\\w.$])%?(?:[fF][pP][sS][cC][rR]|[aA][pP][sS][rR]|[cC][pP][sS][rR]|[sS][pP][sS][rR]|[dD]27|[rR]15|[sS]18|[dD]26|[dD]22|[sS]24|[sS]21|[dD]14|[qQ]15|[dD]11|[dD]23|[sS]25|[sS]26|[sS]16|[sS]19|[dD]15|[dD]28|[rR]14|[sS]14|[sS]28|[dD]12|[dD]19|[dD]31|[sS]12|[dD]13|[dD]10|[qQ]10|[qQ]12|[qQ]14|[rR]11|[dD]29|[rR]10|[rR]12|[sS]29|[sS]22|[sS]13|[qQ]11|[qQ]13|[sS]30|[dD]30|[sS]17|[dD]21|[sS]31|[dD]24|[rR]13|[dD]18|[dD]20|[sS]11|[dD]25|[dD]17|[sS]23|[sS]20|[dD]16|[sS]27|[sS]15|[sS]10|[qQ]9|[rR]1|[sS]3|[qQ]1|[sS]4|[rR]0|[sS][lL]|[lL][rR]|[sS]7|[rR]8|[qQ]7|[sS][bB]|[sS]9|[fF][pP]|[dD]1|[qQ]6|[sS]0|[dD]5|[rR]4|[iI][pP]|[rR]9|[qQ]3|[qQ]0|[sS]2|[sS]8|[sS]6|[sS]1|[qQ]4|[pP][cC]|[dD]6|[rR]5|[dD]3|[dD]0|[sS]5|[qQ]5|[qQ]2|[sS][pP]|[dD]9|[qQ]8|[rR]3|[dD]7|[dD]8|[rR]7|[rR]2|[rR]6|[dD]4|[dD]2)(?:\\.[0-9]*[bBhHsSdDqQ])?(?![\\w.$])",
      "scope": "type"
    },
    {
      "pattern": "(?<![\\w.])(?:[#\\$]?[+-]?(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)|[0-9][0-9a-fA-F]*[hH]|[01]+[bB])(?![\\w.])",
      "scope": "number"
    },
    {
      "pattern": "\\b\\d+[bf]\\b",
      "scope": "annotation"
    },
    {
      "pattern": "[\\[\\]{}(),:+*/=<>!&|^~\\-]|\\$",
      "scope": "operator"
    }
  ]
}
