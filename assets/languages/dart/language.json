{
  "schemaVersion": 1,
  "packageVersion": "0.2.0",
  "id": "dart",
  "name": "Dart",
  "extensions": [
    ".dart"
  ],
  "comments": {
    "line": "//",
    "block": {
      "open": "/*",
      "close": "*/"
    }
  },
  "brackets": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "indentation": {
    "increaseAfter": "{"
  },
  "icons": {
    "symbol": "code"
  },
  "adapters": [],
  "fileTemplates": {
    "class": {
      "name": "Dart class",
      "extension": ".dart",
      "body": "class {{name}} {\n}\n"
    },
    "widget": {
      "name": "Flutter StatelessWidget",
      "extension": ".dart",
      "body": "import 'package:flutter/material.dart';\n\nclass {{name}} extends StatelessWidget {\n  const {{name}}({super.key});\n\n  @override\n  Widget build(BuildContext context) {\n    return const SizedBox.shrink();\n  }\n}\n"
    }
  }
}
