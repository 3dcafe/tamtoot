{
  "schemaVersion": 1,
  "packageVersion": "0.2.0",
  "id": "html",
  "name": "HTML",
  "extensions": [
    ".html",
    ".htm"
  ],
  "comments": {
    "block": {
      "open": "<!--",
      "close": "-->"
    }
  },
  "brackets": [
    {
      "open": "<",
      "close": ">"
    }
  ],
  "autoClosingPairs": [
    {
      "open": "<",
      "close": ">"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "indentation": {
    "increaseAfter": ">"
  },
  "icons": {
    "symbol": "code"
  },
  "adapters": [],
  "fileTemplates": {
    "page": {
      "name": "HTML page",
      "extension": ".html",
      "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>{{name}}</title>\n</head>\n<body>\n</body>\n</html>\n"
    }
  }
}
