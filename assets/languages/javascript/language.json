{
  "schemaVersion": 1,
  "packageVersion": "0.3.0",
  "id": "javascript",
  "name": "JavaScript",
  "extensions": [
    ".js",
    ".mjs",
    ".cjs",
    ".jsx"
  ],
  "comments": {
    "line": "//",
    "block": {
      "open": "/*",
      "close": "*/"
    }
  },
  "brackets": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "indentation": {
    "increaseAfter": "{"
  },
  "icons": {
    "symbol": "code"
  },
  "adapters": [],
  "fileTemplates": {
    "module": {
      "name": "JavaScript module",
      "extension": ".js",
      "body": "// {{name}}\n"
    }
  }
}
